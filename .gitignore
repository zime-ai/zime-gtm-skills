.DS_Store
.session-context/
PLAN.md
.tmp/

# Local-only maintainer skills and per-machine settings -- never public.
.claude/
.agents/

# Real client data — transcripts, ground truth, hand labels, cases that
# reference them, and any eval run output derived from them (company names,
# deal details, real people). Never public. Only evals/framework/* (the
# eval engine itself) and evals/cases.example.yaml (fake client) are public.
evals/transcripts/
evals/gt/
evals/cases/
evals/labels/
evals/baseline-*.json
evals/runs/*
evals/runs.jsonl
evals/amendments.jsonl

# Web-harvested ground truth: quoted excerpts of a third party's published
# critique/transcript, copyright risk if redistributed wholesale. Only the
# public citation registry (evals/gt-web/SOURCES.md) is public.
evals/gt-web/*
!evals/gt-web/SOURCES.md
!evals/gt-web/README.md
__pycache__/

# scripts/scan-content.py's client-name denylist: real client/person names,
# never public. Absence is expected on CI/forks -- the rule skips, it
# doesn't fail. See AGENTS.md's rule registry.
.private/
